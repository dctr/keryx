{
  "name": "keryx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Thin TypeScript control surface over Hermes Kanban for Keryx action items.",
  "scripts": {
    "start": "npm run build && node dist/server/index.js",
    "build": "vite build && vite build --ssr src/server/index.ts --outDir dist/server",
    "test": "vitest run",
    "check": "npm run lint && npm test",
    "test:watch": "vitest",
    "lint": "npm run lint:ts && npm run lint:eslint && npm run lint:sh",
    "lint:ts": "tsc --noEmit --project tsconfig.json",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:sh": "shellcheck keryx-setup.sh",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit --project tsconfig.json",
    "e2e": "playwright test"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "fastify": "^5.8.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^25.9.1",
    "eslint": "^9.39.4",
    "eslint-plugin-svelte": "^3.20.0",
    "shellcheck": "^3.1.0",
    "svelte": "^5.56.0",
    "svelte-check": "^4.4.8",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
